<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Simple Grade Calculator</title>
    <style>
        body { font-family: sans-serif; max-width: 400px; margin: 40px auto; padding: 20px; border: 1px solid #ccc; border-radius: 8px; }
        .input-group { margin-bottom: 10px; }
        input { width: 100%; padding: 8px; margin-top: 5px; box-sizing: border-box; }
        button { width: 100%; padding: 10px; background: #28a745; color: white; border: none; font-size: 16px; margin: 10px 0; cursor: pointer; }
        #result { margin-top: 15px; font-weight: bold; background: #f8f9fa; padding: 10px; display: none; }
    </style>
</head>
<body>

    <h3>Grade Calculator</h3>
    
    <div class="input-group">
        <label>Number of Subjects:</label>
        <input type="number" id="numSubs" min="1">
        <button onclick="createInputs()">Set Subjects</button>
    </div>

    <!-- Container where fields will be created dynamically via loop -->
    <div id="fields"></div>
    <button id="calcBtn" style="display:none;" onclick="calculate()">Calculate</button>
    
    <div id="result"></div>

<script>
function createInputs() {
    let num = parseInt(document.getElementById('numSubs').value);
    let fields = document.getElementById('fields');
    fields.innerHTML = ''; // Reset fields
    
    // Loop to enter marks fields
    for (let i = 1; i <= num; i++) {
        fields.innerHTML += `<div class="input-group"><label>Subject ${i}:</label><input type="number" class="mark" min="0" max="100"></div>`;
    }
    document.getElementById('calcBtn').style.display = num > 0 ? 'block' : 'none';
}

function calculate() {
    let inputs = document.querySelectorAll('.mark');
    let total = 0;
    
    // Loop to calculate total
    for (let input of inputs) {
        total += parseFloat(input.value) || 0;
    }
    
    let avg = total / inputs.length;
    let res = document.getElementById('result');
    
    // Quick Grade logic
    let grade = avg >= 90 ? 'A' : avg >= 70 ? 'B' : avg >= 50 ? 'C' : 'F';
    let status = avg >= 40 ? 'PASS' : 'FAIL';
    
    res.innerHTML = `Total: ${total}<br>Average: ${avg.toFixed(1)}%<br>Grade: ${grade}<br>Status: ${status}`;
    res.style.display = 'block';
}
</script>

</body>
</html>
